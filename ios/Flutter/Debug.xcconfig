#include? "Pods/Target Support Files/Pods-Runner/Pods-Runner.debug.xcconfig"
#include "Generated.xcconfig"

// Xcode 27's `lipo` rejects multiple archs after -verify_arch, which breaks
// Flutter's debug_unpack_ios framework-thinning step when ARCHS is "arm64 x86_64".
// Simulators on Apple Silicon only need arm64.
ARCHS[sdk=iphonesimulator*] = arm64
