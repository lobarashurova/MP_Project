rules_version = '2';

// Xurmo Firestore security rules.
//
// Principles:
//   - Every read and write requires a signed-in user.
//   - A user can only see and change their own profile, favorites, and orders.
//   - Accounts are created with role "user" and a user can never change their
//     own role. Other roles (courier, restaurant, admin) are assigned by an
//     admin through the console or a future admin tool.
//   - Admins can read everything and update orders. Courier and restaurant
//     access will be added when those sides of the app are built.
//
// Deploy with: firebase deploy --only firestore:rules

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    function callerRole() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role;
    }

    function isAdmin() {
      return signedIn() && callerRole() == 'admin';
    }

    // The role field on an incoming write, or null when it is absent.
    function incomingRole() {
      return request.resource.data.get('role', null);
    }

    match /users/{uid} {
      allow read: if isOwner(uid) || isAdmin();

      // A user creates their own profile and it must start as a plain user.
      allow create: if isOwner(uid) && incomingRole() == 'user';

      // A user may edit their profile but not promote themselves.
      allow update: if (isOwner(uid) && incomingRole() == resource.data.get('role', null))
                    || isAdmin();

      allow delete: if isAdmin();

      match /favorites/{mealId} {
        allow read, write: if isOwner(uid);
      }
    }

    match /orders/{orderId} {
      allow create: if signedIn() && request.resource.data.userId == request.auth.uid;
      allow read: if signedIn() && (resource.data.userId == request.auth.uid || isAdmin());
      allow update, delete: if isAdmin();
    }
  }
}
